---
import checklistIcon from "@assets/icons/checklist.png";
import chatIcon from "@assets/icons/chat.png";
import bellIcon from "@assets/icons/bell.png";

const steps = [
  {
    step: "Step 1.",
    title: "Join the Waitlist",
    description: "Sign up today for exclusive early access.",
    image: checklistIcon,
  },
  {
    step: "Step 2.",
    title: "Connect Your WhatsApp Business",
    description: "Prepare to integrate WhatsApp for automated bookings at launch.",
    image: chatIcon,
  },
  {
    step: "Step 3.",
    title: "Track Your Activity",
    description: "Easily monitor your progress with our powerful dashboard!",
    image: bellIcon,
  },
];
---
<div class="mt-24 max-w-3xl mx-auto text-center">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Start now with <span class="text-indigo-600">Vanty</span>
  </h2>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-8 md:gap-16">
  {steps.map((item) => (
    <div class="flex flex-col bg-white shadow-lg rounded-xl p-6">
      <h3 class="text-lg font-bold mb-2">{item.step}</h3>
      <img src={item.image.src} alt={item.title} class="w-20 h-20 mb-4 self-center" />
      <h4 class="text-xl font-semibold mt-2 text-center">{item.title}</h4>
      <p class="text-slate-500 mt-2 leading-relaxed text-center">{item.description}</p>
    </div>
  ))}
</div>
