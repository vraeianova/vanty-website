---
import Picture from "astro/components/Picture.astro"
import logoMeta from "../assets/logos/Meta.svg"
import logoOpenai from "../assets/logos/OpenAI.svg"
import logoSocialenials from "../assets/logos/Socialenials.svg"
import logoWhatsapp from "../assets/logos/Whatsapp.svg"
---

<div>
  <h2 class="text-center text-slate-500">
    Backed by Top Tools and Partners 
  </h2>
  <div
    class="flex gap-x-8 gap-y-4 md:gap-20 lg:gap-28 items-center justify-center mt-6 flex-wrap">

    <div class="text-gray-500 my-2 h-[48px] w-[130px]">
      <Picture src={logoMeta} alt="Meta" loading="lazy" class="h-full w-auto" />
    </div>

    <div class="text-gray-500 my-2 h-[48px] w-[130px]">
      <Picture src={logoOpenai} alt="OpenAI" loading="lazy" class="h-full w-auto" />
    </div>
    
    <div class="text-gray-500 my-2 h-[48px] w-[130px]">
      <Picture src={logoWhatsapp} alt="WhatsApp" loading="lazy" class="h-full w-auto" />
    </div>

    <div class="text-gray-500 my-2 h-[48px] w-[130px]">
      <Picture src={logoSocialenials} alt="Socialenials" loading="lazy" class="h-full w-auto" />
    </div>
  </div>
</div>
