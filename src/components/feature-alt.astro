---
import Badge from "@components/ui/badge.astro";
import { Picture } from "astro:assets";

// Importar imágenes
import ResumenImg from "../assets/features/resumeninteligente.png";
import MensajesImg from "../assets/features/wha.png";
---

<div
  class:list={[
    "max-w-4xl mx-auto flex flex-col items-center justify-center",
     
  ]}>
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-4 text-center">
    The power of WhatsApp
  </h2>
  <p class="text-lg mt-4 text-slate-600 text-center [text-wrap:pretty]">
    Supercharging your bookings with Vanty.
  </p>
</div>



<section class="max-w-7xl mx-auto px-6 py-12 grid md:grid-cols-2 gap-8">
  <div class="relative bg-gray-100 p-6 rounded-2xl shadow-lg h-[340px] flex flex-col justify-center">
    <Picture
      src={ResumenImg}
      alt="Mensajes Automatizados"
      formats={["avif", "webp"]}
      loading="lazy"
      class="rounded-lg"
      height={300}
    />

  <div class="mt-auto">
    <Badge color="purple" class="-ml-px">Mensajes Automatizados</Badge>
    <h2 class="text-2xl font-medium mt-2">Comunicación Automática y Eficiente</h2>
    <p class="text-gray-600 mt-2">
      Simplifica la comunicación, nuestra IA que automatiza recordatorios, confirmaciones y seguimientos para tus pacientes.
    </p>
  </div>
</div>
<div class="relative bg-gray-100 p-6 rounded-2xl shadow-lg h-[340px] flex flex-col justify-end">
  <Picture
    src={MensajesImg}
    alt="Mensajes Automatizados"
    formats={["avif", "webp"]}
    loading="lazy"
    class="rounded-lg "
  />

<div class="mt-auto">
  <Badge color="purple" class="-ml-px">Mensajes Automatizados</Badge>
  <h2 class="text-2xl font-medium mt-2">Comunicación Automática y Eficiente</h2>
  <p class="text-gray-600 mt-2">
    Simplifica la comunicación, nuestra IA que automatiza recordatorios, confirmaciones y seguimientos para tus pacientes.
  </p>
</div>
</div>
</section>
